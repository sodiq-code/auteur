# Secrets — never commit. Obtain from the hackathon organizer / GCP console.
PARALLEL_API_KEY=your_parallel_search_api_key_here

# Google Cloud (Vertex AI, Firestore, Cloud Storage, Cloud Run)
# Use a service account JSON. Either set this env var OR use Workload Identity on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/auteur-sa-key.json
GCP_PROJECT_ID=auteur-506523
GCP_LOCATION=us-central1

# Cloud Storage bucket for rendered artifacts (Veo MP4s, Imagen PNGs)
GCS_RENDERS_BUCKET=gs://auteur-renders
GCS_DEMO_BUCKET=gs://auteur-demo

# Frontend -> backend API base URL (relative in prod; absolute in local dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Run-time feature flags
FEATURE_LIVE_GENERATION=true
FEATURE_PRE_RENDERED_DEMO=true
